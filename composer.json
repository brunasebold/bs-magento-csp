{
    "name": "bs/module-magento-csp",
    "description": "Manage Magento Content Security Policy hosts from the admin and send them on the CSP header without a deploy.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "magento",
        "magento2",
        "csp",
        "content-security-policy"
    ],
    "homepage": "https://github.com/brunasebold/bs-magento-csp",
    "authors": [
        {
            "name": "Bruna Sebold",
            "email": "sebold.bruna@gmail.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "magento/framework": "^103.0.4",
        "magento/module-backend": "^102.0",
        "magento/module-csp": "^100.4",
        "magento/module-page-cache": "^100.4",
        "magento/module-ui": "^101.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BS\\MagentoCsp\\": ""
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "phpcs": "phpcs"
    },
    "repositories": [{
        "name": "bs-magento-csp",
        "type": "vcs",
        "url": "https://github.com/brunasebold/bs-magento-csp.git"
    }]
}
