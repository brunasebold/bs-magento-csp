<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">bs_csp_whitelist_form.whitelist_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="BS\MagentoCsp\Block\Adminhtml\Whitelist\Edit\BackButton"/>
            <button name="delete" class="BS\MagentoCsp\Block\Adminhtml\Whitelist\Edit\DeleteButton"/>
            <button name="save" class="BS\MagentoCsp\Block\Adminhtml\Whitelist\Edit\SaveButton"/>
        </buttons>
        <namespace>bs_csp_whitelist_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>bs_csp_whitelist_form.whitelist_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="whitelist_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="bs_csp/whitelist/save"/>
        </settings>
        <dataProvider class="BS\MagentoCsp\Model\Whitelist\DataProvider" name="whitelist_form_data_source">
            <settings>
                <requestFieldName>whitelist_id</requestFieldName>
                <primaryFieldName>whitelist_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Allowed host</label>
        </settings>
        <field name="whitelist_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>whitelist_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="policy_id" sortOrder="20" formElement="select">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Directive</label>
                <notice translate="true">Use the directive named in the browser error, for example connect-src.</notice>
                <dataScope>policy_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="BS\MagentoCsp\Model\Source\Policy"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="host" sortOrder="30" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Host</label>
                <notice translate="true">Enter only the host, such as *.example.com or https://cdn.example.com. If you paste a full URL, the path is discarded.</notice>
                <dataScope>host</dataScope>
            </settings>
        </field>
        <field name="area" sortOrder="40" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">global</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Area</label>
                <dataScope>area</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="BS\MagentoCsp\Model\Source\Area"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="note" sortOrder="50" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Note</label>
                <dataScope>note</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
